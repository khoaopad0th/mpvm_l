local CONFIG = {
    -- กราฟิก
    RenderDistance   = 256,      -- ระยะ Render (studs) ลดลง = FPS ดีขึ้น
    FPSCap           = 60,       -- จำกัด FPS (30/60/144) ใช้ 30 ถ้า PC อ่อน
    QualityLevel     = 1,        -- Graphics Quality 1-21 (1 = ต่ำสุด)
    DisableShadows   = true,     -- ปิดเงา
    DisableFog       = true,     -- ปิดหมอก
    DisableParticles = true,     -- ปิด Particle Effects
    DisableBeams     = true,     -- ปิด Beam Effects
    DisableBillboards= true,     -- ปิด BillboardGui ใน Workspace
    DisableDecals    = false,    -- ปิด Decals/Textures (เปิดถ้า PC อ่อนมาก)
    DisableSurfaceGUI= false,    -- ปิด SurfaceGui (เปิดถ้าต้องการ)

    -- เครือข่าย
    OptimizeNetwork  = true,     -- ลด Network overhead
    SendRate         = 30,       -- ความถี่ส่ง Input (Hz) ลดช่วย Lag

    -- ทั่วไป
    GCInterval       = 60,       -- Garbage Collect ทุกกี่วินาที (0 = ปิด)
