local _connections = {}
local _origValues  = {}

-- ── Utility ────────────────────────────────────────────────
local function Log(msg)
    print("[LagReducer] " .. tostring(msg))
end

local function SafeSet(obj, prop, val)
    -- บันทึกค่าเดิม (ครั้งแรก)
    if _origValues[obj] == nil then
        _origValues[obj] = {}
    end
    if _origValues[obj][prop] == nil then
        local ok, v = pcall(function() return obj[prop] end)
        if ok then _origValues[obj][prop] = v end
    end
    -- ตั้งค่าใหม่
    local ok, err = pcall(function() obj[prop] = val end)
    if not ok then
        -- silent fail — บาง property เป็น read-only ใน executor บางตัว
    end
end

-- ── 1. Graphics Quality ────────────────────────────────────
local function ApplyGraphics()
    -- UserGameSettings (ถ้า executor support)
    local ugs = UserSettings and UserSettings():GetService("UserGameSettings")
    if ugs then
        SafeSet(ugs, "SavedQualityLevel", Enum.SavedQualitySetting.QualityLevel1)
    end

    -- Lighting
    SafeSet(Lighting, "GlobalShadows",    not CONFIG.DisableShadows)
    SafeSet(Lighting, "FogEnd",           CONFIG.DisableFog and 1e9 or Lighting.FogEnd)
    SafeSet(Lighting, "FogStart",         CONFIG.DisableFog and 1e9 or Lighting.FogStart)
    SafeSet(Lighting, "Brightness",       1)
    SafeSet(Lighting, "ClockTime",        14) -- กลางวัน ลด dynamic shadow cost

    -- Camera
    SafeSet(Camera, "MaxAxisFieldOfView", 70)
    SafeSet(Camera, "CameraType",         Enum.CameraType.Custom)

    -- Render Fidelity / Distance
    settings().Rendering.QualityLevel = CONFIG.QualityLevel  -- บาง executor อนุญาต

    Log("✅ Graphics optimised (Quality=" .. CONFIG.QualityLevel .. ")")
end

-- ── 2. Disable Particles / Beams / Decals ─────────────────
local function DisableEffects(parent)
    for _, v in ipairs(parent:GetDescendants()) do
        local cn = v.ClassName
        if CONFIG.DisableParticles and cn == "ParticleEmitter" then
            SafeSet(v, "Enabled", false)
            SafeSet(v, "Rate",    0)
        end
        if CONFIG.DisableParticles and cn == "Smoke" then
            SafeSet(v, "Enabled", false)
        end
        if CONFIG.DisableParticles and cn == "Fire" then
            SafeSet(v, "Enabled", false)
        end
        if CONFIG.DisableParticles and cn == "Sparkles" then
            SafeSet(v, "Enabled", false)
        end
        if CONFIG.DisableBeams and cn == "Beam" then
            SafeSet(v, "Enabled", false)
        end
        if CONFIG.DisableBillboards and cn == "BillboardGui" then
            SafeSet(v, "Enabled", false)
        end
        if CONFIG.DisableDecals and (cn == "Decal" or cn == "Texture") then
            SafeSet(v, "Transparency", 1)
        end
        if CONFIG.DisableSurfaceGUI and cn == "SurfaceGui" then
            SafeSet(v, "Enabled", false)
        end
    end
end

-- ทำงานใน workspace และฟัง descendant ใหม่
local function SetupEffectDisabler()
    DisableEffects(workspace)
    local conn = workspace.DescendantAdded:Connect(function(d)
        task.defer(function()
            local cn = d.ClassName
            if CONFIG.DisableParticles and
               (cn == "ParticleEmitter" or cn == "Smoke" or cn == "Fire" or cn == "Sparkles") then
                SafeSet(d, "Enabled", false)
                SafeSet(d, "Rate",    0)
            elseif CONFIG.DisableBeams and cn == "Beam" then
                SafeSet(d, "Enabled", false)
            elseif CONFIG.DisableBillboards and cn == "BillboardGui" then
                SafeSet(d, "Enabled", false)
            elseif CONFIG.DisableDecals and (cn == "Decal" or cn == "Texture") then
                SafeSet(d, "Transparency", 1)
            end
        end)
    end)
    table.insert(_connections, conn)
    Log("✅ Effect disabler active")
end

-- ── 3. Render Distance (LOD hack) ─────────────────────────
local function ApplyRenderDistance()
    -- ซ่อน Part ที่ไกลเกิน CONFIG.RenderDistance จาก Camera
    -- (ทำด้วย Heartbeat เบาๆ)
    local dist2 = CONFIG.RenderDistance * CONFIG.RenderDistance
    local tick_  = 0
    local conn = RunService.Heartbeat:Connect(function(dt)
        tick_ = tick_ + dt
        if tick_ < 0.5 then return end  -- ทำทุก 0.5s เพื่อประหยัด CPU
        tick_ = 0

        local camPos = Camera.CFrame.Position
        for _, part in ipairs(workspace:GetDescendants()) do
            if part:IsA("BasePart") and not part:IsDescendantOf(LocalPlayer.Character or {}) then
                local d2 = (part.Position - camPos).Magnitude
                -- ใช้ LocalTransparencyModifier เพื่อไม่ให้กระทบ Server
                if part:IsA("BasePart") then
                    local far = (d2 > dist2)
                    -- เฉพาะ Part ที่ไม่ใช่พื้นหลัก (ความสูง < 5 studs และ size เล็ก)
                    if far and part.Size.Magnitude < 20 then
                        part.LocalTransparencyModifier = 1
                    else
                        part.LocalTransparencyModifier = 0
                    end
                end
            end
        end
    end)
    table.insert(_connections, conn)
    Log("✅ Render distance limit: " .. CONFIG.RenderDistance .. " studs")
end

