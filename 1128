    "Mod_Script": "local RunService = game:GetService(\"RunService\")\nlocal Players = game:GetService(\"Players\")\nlocal Lighting = game:GetService(\"Lighting\")\nlocal TweenService = game:GetService(\"TweenService\")\nlocal Stats = game:GetService(\"Stats\")\n\nlocal LocalPlayer = Players.LocalPlayer\nlocal Camera = workspace.CurrentCamera\n\nlocal CONFIG = {\n    RenderDistance   = 256,\n    FPSCap           = 60,\n    QualityLevel     = 1,\n    DisableShadows   = true,\n    DisableFog       = true,\n    DisableParticles = true,\n    DisableBeams     = true,\n    DisableBillboards= true,\n    DisableDecals    = false,\n    DisableSurfaceGUI= false,\n    OptimizeNetwork  = true,\n    SendRate         = 30,\n    GCInterval       = 60,\n    ShowStats        = true,\n    AutoReapply      = true,\n}\n\nlocal _connections = {}\nlocal _origValues  = {}\n\nlocal function Log(msg)\n    print(\"[LagReducer] \" .. tostring(msg))\nend\n\nlocal function SafeSet(obj, prop, val)\n    if _origValues[obj] == nil then\n        _origValues[obj] = {}\n    end\n    if _origValues[obj][prop] == nil then\n        local ok, v = pcall(function() return obj[prop] end)\n        if ok then _origValues[obj][prop] = v end\n    end\n    pcall(function() obj[prop] = val end)\nend\n\nlocal function ApplyGraphics()\n    local ugs = UserSettings and UserSettings():GetService(\"UserGameSettings\")\n    if ugs then\n        SafeSet(ugs, \"SavedQualityLevel\", Enum.SavedQualitySetting.QualityLevel1)\n    end\n    SafeSet(Lighting, \"GlobalShadows\", not CONFIG.DisableShadows)\n    SafeSet(Lighting, \"FogEnd\",        CONFIG.DisableFog and 1e9 or Lighting.FogEnd)\n    SafeSet(Lighting, \"FogStart\",      CONFIG.DisableFog and 1e9 or Lighting.FogStart)\n    SafeSet(Lighting, \"Brightness\",    1)\n    SafeSet(Lighting, \"ClockTime\",     14)\n    SafeSet(Camera,   \"MaxAxisFieldOfView\", 70)\n    SafeSet(Camera,   \"CameraType\",    Enum.CameraType.Custom)\n    settings().Rendering.QualityLevel = CONFIG.QualityLevel\n    Log(\"Graphics optimised\")\nend\n\nlocal function DisableEffects(parent)\n    for _, v in ipairs(parent:GetDescendants()) do\n        local cn = v.ClassName\n        if CONFIG.DisableParticles and cn == \"ParticleEmitter\" then SafeSet(v, \"Enabled\", false) SafeSet(v, \"Rate\", 0) end\n        if CONFIG.DisableParticles and cn == \"Smoke\"           then SafeSet(v, \"Enabled\", false) end\n        if CONFIG.DisableParticles and cn == \"Fire\"            then SafeSet(v, \"Enabled\", false) end\n        if CONFIG.DisableParticles and cn == \"Sparkles\"        then SafeSet(v, \"Enabled\", false) end\n        if CONFIG.DisableBeams     and cn == \"Beam\"            then SafeSet(v, \"Enabled\", false) end\n        if CONFIG.DisableBillboards and cn == \"BillboardGui\"   then SafeSet(v, \"Enabled\", false) end\n        if CONFIG.DisableDecals    and (cn == \"Decal\" or cn == \"Texture\") then SafeSet(v, \"Transparency\", 1) end\n        if CONFIG.DisableSurfaceGUI and cn == \"SurfaceGui\"     then SafeSet(v, \"Enabled\", false) end\n    end\nend\n\nlocal function SetupEffectDisabler()\n    DisableEffects(workspace)\n    local conn = workspace.DescendantAdded:Connect(function(d)\n        task.defer(function()\n            local cn = d.ClassName\n            if CONFIG.DisableParticles and (cn == \"ParticleEmitter\" or cn == \"Smoke\" or cn == \"Fire\" or cn == \"Sparkles\") then\n                SafeSet(d, \"Enabled\", false) SafeSet(d, \"Rate\", 0)\n            elseif CONFIG.DisableBeams and cn == \"Beam\" then SafeSet(d, \"Enabled\", false)\n            elseif CONFIG.DisableBillboards and cn == \"BillboardGui\" then SafeSet(d, \"Enabled\", false)\n            elseif CONFIG.DisableDecals and (cn == \"Decal\" or cn == \"Texture\") then SafeSet(d, \"Transparency\", 1)\n            end\n        end)\n    end)\n    table.insert(_connections, conn)\n    Log(\"Effect disabler active\")\nend\n\nlocal function ApplyRenderDistance()\n    local dist2 = CONFIG.RenderDistance * CONFIG.RenderDistance\n    local tick_ = 0\n    local conn = RunService.Heartbeat:Connect(function(dt)\n        tick_ = tick_ + dt\n        if tick_ < 0.5 then return end\n        tick_ = 0\n        local camPos = Camera.CFrame.Position\n        for _, part in ipairs(workspace:GetDescendants()) do\n            if part:IsA(\"BasePart\") and not part:IsDescendantOf(LocalPlayer.Character or {}) then\n                local d2 = (part.Position - camPos).Magnitude\n                if part:IsA(\"BasePart\") then\n                    local far = (d2 > dist2)\n                    if far and part.Size.Magnitude < 20 then\n                        part.LocalTransparencyModifier = 1\n                    else\n                        part.LocalTransparencyModifier = 0\n                    end\n                end\n            end\n        end\n    end)\n    table.insert(_connections, conn)\n    Log(\"Render distance: \" .. CONFIG.RenderDistance)\nend\n\nlocal function ApplyFPSCap()\n    local conn = RunService.RenderStepped:Connect(function(dt) end)\n    if setfpscap then\n        setfpscap(CONFIG.FPSCap)\n        Log(\"FPS cap: \" .. CONFIG.FPSCap)\n    else\n        Log(\"setfpscap() not supported\")\n    end\n    conn:Disconnect()\nend\n\nlocal function StartGC()\n    if CONFIG.GCInterval <= 0 then return end\n    local conn = RunService.Heartbeat:Connect(function()\n        if os.clock() % CONFIG.GCInterval < 0.016 then\n            collectgarbage(\"collect\")\n        end\n    end)\n    table.insert(_connections, conn)\n    Log(\"GC every \" .. CONFIG.GCInterval .. \"s\")\nend\n\nlocal _hudGui\nlocal function CreateHUD()\n    if not CONFIG.ShowStats then return end\n    if _hudGui then _hudGui:Destroy() end\n    local gui = Instance.new(\"ScreenGui\")\n    gui.Name           = \"LagReducerHUD\"\n    gui.ResetOnSpawn   = false\n    gui.IgnoreGuiInset = true\n    gui.DisplayOrder   = 999\n    gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling\n    local frame = Instance.new(\"Frame\", gui)\n    frame.Size                 = UDim2.new(0, 180, 0, 70)\n    frame.Position             = UDim2.new(1, -190, 0, 10)\n    frame.BackgroundColor3     = Color3.fromRGB(10, 10, 10)\n    frame.BackgroundTransparency = 0.35\n    frame.BorderSizePixel      = 0\n    local corner = Instance.new(\"UICorner\", frame)\n    corner.CornerRadius = UDim.new(0, 8)\n    local function MakeLabel(text, yOffset)\n        local lbl = Instance.new(\"TextLabel\", frame)\n        lbl.Size               = UDim2.new(1, -10, 0, 22)\n        lbl.Position           = UDim2.new(0, 5, 0, yOffset)\n        lbl.BackgroundTransparency = 1\n        lbl.TextColor3         = Color3.fromRGB(180, 255, 140)\n        lbl.Font               = Enum.Font.Code\n        lbl.TextSize           = 13\n        lbl.TextXAlignment     = Enum.TextXAlignment.Left\n        lbl.Text               = text\n        return lbl\n    end\n    local lblTitle = MakeLabel(\"Lag Reducer v2.0\", 4)\n    lblTitle.TextColor3 = Color3.fromRGB(120, 200, 255)\n    lblTitle.Font       = Enum.Font.GothamBold\n    local lblFPS  = MakeLabel(\"FPS : -\", 26)\n    local lblPing = MakeLabel(\"Ping: -\", 46)\n    local lastFPSTime = tick()\n    local frameCount  = 0\n    local conn = RunService.RenderStepped:Connect(function()\n        frameCount = frameCount + 1\n        local now = tick()\n        local elapsed = now - lastFPSTime\n        if elapsed >= 0.5 then\n            local fps  = math.floor(frameCount / elapsed)\n            local ping = math.floor(Stats.Network.ServerStatsItem[\"Data Ping\"]:GetValue())\n            lblFPS.Text  = \"FPS : \" .. fps\n            lblPing.Text = \"Ping: \" .. ping .. \" ms\"\n            lblFPS.TextColor3  = fps  >= 55 and Color3.fromRGB(140,255,140) or fps  >= 30 and Color3.fromRGB(255,220,80) or Color3.fromRGB(255,80,80)\n            lblPing.TextColor3 = ping <= 80  and Color3.fromRGB(140,255,140) or ping <= 150 and Color3.fromRGB(255,220,80) or Color3.fromRGB(255,80,80)\n            frameCount  = 0\n            lastFPSTime = now\n        end\n    end)\n    table.insert(_connections, conn)\n    local ok, err = pcall(function() gui.Parent = LocalPlayer:WaitForChild(\"PlayerGui\") end)\n    if not ok then Log(\"HUD error: \" .. tostring(err)) gui:Destroy() return end\n    _hudGui = gui\n    Log(\"HUD active\")\nend\n\nlocal function ApplyNetworkOpt()\n    if not CONFIG.OptimizeNetwork then return end\n    for _, player in ipairs(Players:GetPlayers()) do\n        if player ~= LocalPlayer and player.Character then\n            local animator = player.Character:FindFirstChildOfClass(\"Animator\")\n            if animator then\n                local dist = (player.Character:GetPivot().Position - (LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position or Vector3.zero)).Magnitude\n                if dist > CONFIG.RenderDistance * 1.5 then\n                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do\n                        track:AdjustSpeed(0)\n                    end\n                end\n            end\n        end\n    end\n    Log(\"Network optimization applied\")\nend\n\nlocal function OnCharacterAdded(char)\n    task.wait(1)\n    if CONFIG.AutoReapply then\n        DisableEffects(char)\n        Log(\"Re-applied to new character\")\n    end\nend\n\nlocal function Init()\n    for _, c in ipairs(_connections) do if c and c.Disconnect then c:Disconnect() end end\n    _connections = {}\n    ApplyGraphics()\n    SetupEffectDisabler()\n    ApplyRenderDistance()\n    ApplyFPSCap()\n    StartGC()\n    CreateHUD()\n    ApplyNetworkOpt()\n    LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)\n    Log(\"Lag Reducer active! FPS:\" .. CONFIG.FPSCap .. \" Q:\" .. CONFIG.QualityLevel)\nend\n\nInit()\n\nfunction LagReducer_Cleanup()\n    for _, c in ipairs(_connections) do if c and c.Disconnect then c:Disconnect() end end\n    _connections = {}\n    for obj, props in pairs(_origValues) do\n        for prop, val in pairs(props) do pcall(function() obj[prop] = val end) end\n    end\n    if _hudGui then _hudGui:Destroy() end\n    Log(\"Lag Reducer stopped and reset\")\nend"
