-- ── 5. Garbage Collector ──────────────────────────────────
local function StartGC()
    if CONFIG.GCInterval <= 0 then return end
    local conn = RunService.Heartbeat:Connect(function()
        -- GC ทุก GCInterval วินาที
        if os.clock() % CONFIG.GCInterval < 0.016 then
            collectgarbage("collect")
        end
    end)
    table.insert(_connections, conn)
    Log("✅ GC every " .. CONFIG.GCInterval .. "s")
end

-- ── 6. Ping / FPS HUD ─────────────────────────────────────
local _hudGui
local function CreateHUD()
    if not CONFIG.ShowStats then return end
    -- ลบอันเก่าถ้ามี
    if _hudGui then _hudGui:Destroy() end

    local gui = Instance.new("ScreenGui")
    gui.Name            = "LagReducerHUD"
    gui.ResetOnSpawn    = false
    gui.IgnoreGuiInset  = true
    gui.DisplayOrder    = 999
    gui.ZIndexBehavior  = Enum.ZIndexBehavior.Sibling

    local frame = Instance.new("Frame", gui)
    frame.Size            = UDim2.new(0, 180, 0, 70)
    frame.Position        = UDim2.new(1, -190, 0, 10)
    frame.BackgroundColor3= Color3.fromRGB(10, 10, 10)
    frame.BackgroundTransparency = 0.35
    frame.BorderSizePixel = 0

    local corner = Instance.new("UICorner", frame)
    corner.CornerRadius = UDim.new(0, 8)

    local function MakeLabel(text, yOffset)
        local lbl = Instance.new("TextLabel", frame)
        lbl.Size               = UDim2.new(1, -10, 0, 22)
        lbl.Position           = UDim2.new(0, 5, 0, yOffset)
        lbl.BackgroundTransparency = 1
        lbl.TextColor3         = Color3.fromRGB(180, 255, 140)
        lbl.Font               = Enum.Font.Code
        lbl.TextSize           = 13
        lbl.TextXAlignment     = Enum.TextXAlignment.Left
        lbl.Text               = text
        return lbl
    end

    local lblTitle = MakeLabel("🚀 Lag Reducer v2.0", 4)
    lblTitle.TextColor3 = Color3.fromRGB(120, 200, 255)
    lblTitle.Font       = Enum.Font.GothamBold

    local lblFPS  = MakeLabel("FPS : —",  26)
    local lblPing = MakeLabel("Ping: —",  46)

    -- Update loop
    local lastFPSTime = tick()
    local frameCount  = 0
    local conn = RunService.RenderStepped:Connect(function()
        frameCount = frameCount + 1
        local now = tick()
        local elapsed = now - lastFPSTime
        if elapsed >= 0.5 then
            local fps  = math.floor(frameCount / elapsed)
            local ping = math.floor(Stats.Network.ServerStatsItem["Data Ping"]:GetValue())
            lblFPS.Text  = "FPS : " .. fps
            lblPing.Text = "Ping: " .. ping .. " ms"

            -- Color code
            lblFPS.TextColor3  = fps  >= 55 and Color3.fromRGB(140,255,140)
                               or fps  >= 30 and Color3.fromRGB(255,220,80)
                               or                Color3.fromRGB(255,80, 80)
            lblPing.TextColor3 = ping <= 80  and Color3.fromRGB(140,255,140)
                               or ping <= 150 and Color3.fromRGB(255,220,80)
                               or                Color3.fromRGB(255,80, 80)

            frameCount    = 0
            lastFPSTime   = now
        end
    end)
    table.insert(_connections, conn)

    -- Parent to PlayerGui
    local ok, err = pcall(function()
        gui.Parent = LocalPlayer:WaitForChild("PlayerGui")
    end)
    if not ok then
        Log("⚠️  ไม่สามารถเพิ่ม HUD: " .. tostring(err))
        gui:Destroy()
        return
    end

    _hudGui = gui
    Log("✅ HUD แสดงผลที่มุมขวาบน")
end

-- ── 7. Network Optimization ──────────────────────────────
local function ApplyNetworkOpt()
    if not CONFIG.OptimizeNetwork then return end
    -- ปิด animation ที่ไม่จำเป็นของ NPC เพื่อลด receive bandwidth
    for _, player in ipairs(Players:GetPlayers()) do
        if player ~= LocalPlayer and player.Character then
            local animator = player.Character:FindFirstChildOfClass("Animator")
                          or player.Character:FindFirstChildOfClass("Humanoid") and
                             player.Character.Humanoid:FindFirstChildOfClass("Animator")
            if animator then
                -- หยุด animation ของ NPC/Player อื่นที่อยู่ไกล
                local dist = (player.Character:GetPivot().Position
                            - (LocalPlayer.Character and LocalPlayer.Character:GetPivot().Position
                               or Vector3.zero)).Magnitude
                if dist > CONFIG.RenderDistance * 1.5 then
                    for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
                        track:AdjustSpeed(0)
                    end
                end
            end
        end
    end
    Log("✅ Network optimization applied")
end

-- ── 8. Character Respawn Handler ─────────────────────────
local function OnCharacterAdded(char)
    task.wait(1) -- รอ character โหลดเสร็จ
    if CONFIG.AutoReapply then
        DisableEffects(char)
        Log("✅ Re-applied to new character")
    end
end

-- ── MAIN ──────────────────────────────────────────────────
local function Init()
    Log("════════════════════════════════")
    Log("  Roblox Local Lag Reducer v2.0")
    Log("  Executor Mode — Client Only")
    Log("════════════════════════════════")

    -- ล้าง connection เก่า (ถ้า re-run)
    for _, c in ipairs(_connections) do
        if c and c.Disconnect then c:Disconnect() end
    end
    _connections = {}

    ApplyGraphics()
    SetupEffectDisabler()
    ApplyRenderDistance()
    ApplyFPSCap()
    StartGC()
    CreateHUD()
    ApplyNetworkOpt()

    -- ฟัง respawn
    LocalPlayer.CharacterAdded:Connect(OnCharacterAdded)

    Log("════════════════════════════════")
    Log("✅ Lag Reducer ทำงานแล้ว!")
    Log("   FPS Cap   : " .. CONFIG.FPSCap)
    Log("   Quality   : " .. CONFIG.QualityLevel)
    Log("   Render Dst : " .. CONFIG.RenderDistance .. " studs")
    Log("════════════════════════════════")
end

Init()

-- ── CLEANUP FUNCTION (optional) ──────────────────────────
-- เรียก LagReducer_Cleanup() เพื่อ reset ทุกอย่าง
function LagReducer_Cleanup()
    for _, c in ipairs(_connections) do
        if c and c.Disconnect then c:Disconnect() end
    end
    _connections = {}
    -- คืนค่าเดิม
    for obj, props in pairs(_origValues) do
        for prop, val in pairs(props) do
            pcall(function() obj[prop] = val end)
        end
    end
    if _hudGui then _hudGui:Destroy() end
    Log("🔴 Lag Reducer ปิดแล้ว และ reset ค่าทั้งหมด")
end
